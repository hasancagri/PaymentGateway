<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Agent Framework A2A hosting API'leri [Experimental] — diagnostic bastır. -->
        <NoWarn>$(NoWarn);MEAI001;OPENAI001;A2A001</NoWarn>
        <UserSecretsId>7c2f1e04-6b3a-4d21-9a55-2e8f4b6c1d90</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Agents.AI" />
        <PackageReference Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore" />
        <PackageReference Include="Microsoft.Extensions.AI" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
        <PackageReference Include="ModelContextProtocol.Core" />
        <PackageReference Include="A2A" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\aspire\ServiceDefaults\ServiceDefaults.csproj" />
    </ItemGroup>

</Project>