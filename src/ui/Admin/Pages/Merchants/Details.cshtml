@page "{id:guid}"
@model Admin.Pages.Merchants.DetailsModel
@{
    ViewData["Title"] = "Merchant Detay";
}

<partial name="_Messages" />

@if (Model.Merchant is null)
{
    <p class="muted">Merchant bulunamadı.</p>
}
else
{
    var m = Model.Merchant;
    <table>
        <tr><th>MerchantId</th><td class="key">@m.MerchantId</td></tr>
        <tr><th>MerchantKey</th><td class="key">@m.MerchantKey</td></tr>
        <tr><th>İsim</th><td>@m.Name</td></tr>
        <tr><th>Tip</th><td>@m.Type</td></tr>
        <tr><th>Durum</th><td>@m.Status</td></tr>
        <tr><th>E-posta</th><td>@m.Email</td></tr>
        <tr><th>Telefon</th><td>@m.GsmNumber</td></tr>
        <tr><th>Adres</th><td>@m.Address</td></tr>
        <tr><th>IBAN</th><td>@m.Iban</td></tr>
        <tr><th>İletişim</th><td>@m.ContactName @m.ContactSurname</td></tr>
        @if (m.IdentityNumber is not null)
        {
            <tr><th>TCKN</th><td>@m.IdentityNumber</td></tr>
        }
        @if (m.TaxOffice is not null)
        {
            <tr><th>Vergi Dairesi</th><td>@m.TaxOffice</td></tr>
        }
        @if (m.TaxNumber is not null)
        {
            <tr><th>Vergi No</th><td>@m.TaxNumber</td></tr>
        }
        @if (m.LegalCompanyTitle is not null)
        {
            <tr><th>Ticari Unvan</th><td>@m.LegalCompanyTitle</td></tr>
        }
        <tr><th>SubMerchantKey</th><td>@(m.SubMerchantKey ?? "—")</td></tr>
        <tr><th>Oluşturma</th><td>@m.CreatedTime.ToString("g")</td></tr>
    </table>

    <div class="actions">
        <a class="btn" asp-page="Index" style="background:#6e7781;">Listeye dön</a>
    </div>
}