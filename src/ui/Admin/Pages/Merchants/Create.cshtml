@page
@model Admin.Pages.Merchants.CreateModel
@{
    ViewData["Title"] = "Yeni Merchant";
}

<partial name="_Messages" />

<form method="post">
    <label asp-for="Input.Name">İsim</label>
    <input asp-for="Input.Name" />

    <label asp-for="Input.Email">E-posta</label>
    <input asp-for="Input.Email" />

    <label asp-for="Input.Phone">Telefon</label>
    <input asp-for="Input.Phone" placeholder="+902121234567" />

    <label asp-for="Input.CountryCode">Ülke kodu</label>
    <input asp-for="Input.CountryCode" placeholder="TR" />

    <label asp-for="Input.CityCode">Şehir kodu</label>
    <input asp-for="Input.CityCode" placeholder="34" />

    <label asp-for="Input.Mcc">MCC (4 hane)</label>
    <input asp-for="Input.Mcc" placeholder="5411" />

    <label asp-for="Input.WebhookUrl">Webhook URL</label>
    <input asp-for="Input.WebhookUrl" placeholder="https://ornek.com/webhook" />

    <div>
        <button type="submit">Oluştur</button>
        <a class="btn" asp-page="Index" style="background:#6e7781;">İptal</a>
    </div>
</form>

<p class="muted">Geçerli MCC örnekleri: 5411, 5311, 5651, 5732, 5912, 5814. Şehir: 34, 06, 35, 16, 07 (ülke TR).</p>