@page
@model Admin.Pages.Merchants.IndexModel
@{
    ViewData["Title"] = "Merchant'lar";
}

<partial name="_Messages" />

@if (Model.Merchants.Count == 0)
{
    <p class="muted">Kayıtlı merchant yok.</p>
}
else
{
    <table>
        <thead>
            <tr><th>İsim</th><th>Tip</th><th>E-posta</th><th>Durum</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Merchants)
            {
                <tr>
                    <td>@m.Name</td>
                    <td>@m.Type</td>
                    <td>@m.Email</td>
                    <td>@m.Status</td>
                    <td><a asp-page="Details" asp-route-id="@m.MerchantId">Detay</a></td>
                </tr>
            }
        </tbody>
    </table>
}