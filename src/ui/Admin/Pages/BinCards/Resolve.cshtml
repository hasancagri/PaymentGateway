@page
@using Admin.PageModels
@model Admin.Pages.BinCards.ResolveModel
@{
    ViewData["Title"] = "BIN Ara";
}

<partial name="_Messages" />

<div class="actions">
    <a class="btn" asp-page="Index">Katalog Listesi</a>
</div>

<form method="get">
    <label asp-for="Bin">BIN (6 veya 8 hane)</label>
    <input asp-for="Bin" inputmode="numeric" maxlength="8" placeholder="ör. 365770" />
    <button type="submit" class="inline">Ara</button>
</form>

@if (Model.Detail is { } d)
{
    <table>
        <tbody>
            <tr><th style="width:220px;">BIN</th><td class="key">@d.BinNumber</td></tr>
            <tr><th>Banka Kodu</th><td>@d.BankCode</td></tr>
            <tr><th>Kart Tipi</th><td>@BinCardLabels.Type(d.CardType)</td></tr>
            <tr><th>Marka</th><td>@BinCardLabels.Brand(d.CardBrand)</td></tr>
            <tr><th>Program</th><td>@BinCardLabels.Program(d.CardProgram)</td></tr>
            <tr><th>Ticari Kart</th><td>@BinCardLabels.Commercial(d.Commercial)</td></tr>
            <tr>
                <th>Taksit Yapılabilen Bankalar</th>
                <td>
                    @if (d.InstallmentBankCodes.Count == 0)
                    {
                        <span class="muted">Taksit yapılamaz (banka kartı / uygun program yok).</span>
                    }
                    else
                    {
                        @string.Join(", ", d.InstallmentBankCodes)
                    }
                </td>
            </tr>
        </tbody>
    </table>
}
else if (Model.Searched && Model.Errors.Count == 0)
{
    <p class="muted">Bu BIN katalogda bulunamadı.</p>
}