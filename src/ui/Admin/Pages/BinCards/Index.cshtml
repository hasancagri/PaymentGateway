@page
@using Admin.PageModels
@model Admin.Pages.BinCards.IndexModel
@{
    ViewData["Title"] = "BIN Kataloğu";

    // Sayfalama penceresi: aktif sayfa etrafında ± + ilk/son; boşluklar "…".
    var cur = Model.Result.Page;
    var last = Model.Result.PageCount;
    var nums = new SortedSet<int> { 1, last < 1 ? 1 : last };
    for (var i = cur - 2; i <= cur + 2; i++)
    {
        if (i >= 1 && i <= last) nums.Add(i);
    }
    var pageNums = nums.Where(n => n >= 1 && n <= last).ToList();

    // Filtreleri + hedef sayfayı taşıyan route verisi (yalnız dolu filtreler).
    Func<int, Dictionary<string, string>> rv = n =>
    {
        var d = new Dictionary<string, string> { ["PageNo"] = n.ToString() };
        if (!string.IsNullOrEmpty(Model.BankCode)) d["BankCode"] = Model.BankCode;
        if (!string.IsNullOrEmpty(Model.CardProgram)) d["CardProgram"] = Model.CardProgram;
        if (!string.IsNullOrEmpty(Model.CardType)) d["CardType"] = Model.CardType;
        if (!string.IsNullOrEmpty(Model.CardBrand)) d["CardBrand"] = Model.CardBrand;
        if (Model.Commercial.HasValue) d["Commercial"] = Model.Commercial.Value.ToString();
        return d;
    };
}

<partial name="_Messages" />

<div class="actions">
    <a class="btn" asp-page="Resolve">BIN Ara</a>
</div>

<form method="get">
    <label asp-for="BankCode">Banka Kodu</label>
    <input asp-for="BankCode" maxlength="4" placeholder="ör. 0062" style="max-width:120px;" />

    <label asp-for="CardProgram">Program</label>
    <select asp-for="CardProgram">
        <option value="">(hepsi)</option>
        @foreach (var o in BinCardLabels.ProgramOptions)
        {
            <option value="@o.Key">@o.Value</option>
        }
    </select>

    <label asp-for="CardType">Kart Tipi</label>
    <select asp-for="CardType">
        <option value="">(hepsi)</option>
        @foreach (var o in BinCardLabels.TypeOptions)
        {
            <option value="@o.Key">@o.Value</option>
        }
    </select>

    <label asp-for="CardBrand">Marka</label>
    <select asp-for="CardBrand">
        <option value="">(hepsi)</option>
        @foreach (var o in BinCardLabels.BrandOptions)
        {
            <option value="@o.Key">@o.Value</option>
        }
    </select>

    <label asp-for="Commercial">Ticari</label>
    <select asp-for="Commercial">
        <option value="">(hepsi)</option>
        <option value="true">Evet</option>
        <option value="false">Hayır</option>
    </select>

    <button type="submit" class="inline">Filtrele</button>
</form>

@if (Model.Result.Items.Count == 0)
{
    <p class="muted">Sonuç yok.</p>
}
else
{
    <table>
        <thead>
            <tr><th>BIN</th><th>Banka Kodu</th><th>Kart Tipi</th><th>Marka</th><th>Program</th><th>Ticari</th></tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Result.Items)
            {
                <tr>
                    <td class="key">@r.BinNumber</td>
                    <td>@r.BankCode</td>
                    <td>@BinCardLabels.Type(r.CardType)</td>
                    <td>@BinCardLabels.Brand(r.CardBrand)</td>
                    <td>@BinCardLabels.Program(r.CardProgram)</td>
                    <td>@BinCardLabels.Commercial(r.Commercial)</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="grid-pager">
        @if (cur > 1)
        {
            <a class="btn" asp-page="Index" asp-all-route-data="rv(cur - 1)">‹ Önceki</a>
        }
        else
        {
            <button type="button" class="btn" disabled>‹ Önceki</button>
        }

        @for (var idx = 0; idx < pageNums.Count; idx++)
        {
            if (idx > 0 && pageNums[idx] - pageNums[idx - 1] > 1)
            {
                <span class="page-gap">…</span>
            }
            if (pageNums[idx] == cur)
            {
                <span class="page-current">@pageNums[idx]</span>
            }
            else
            {
                <a class="page-link" asp-page="Index" asp-all-route-data="rv(pageNums[idx])">@pageNums[idx]</a>
            }
        }

        @if (cur < last)
        {
            <a class="btn" asp-page="Index" asp-all-route-data="rv(cur + 1)">Sonraki ›</a>
        }
        else
        {
            <button type="button" class="btn" disabled>Sonraki ›</button>
        }

        <span class="muted">@Model.Result.TotalCount kayıt</span>
    </div>
}