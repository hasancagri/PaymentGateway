@page
@model Admin.Pages.CommissionPolicies.IndexModel
@{
    ViewData["Title"] = "Komisyon Politikaları";
}

<partial name="_Messages" />

<h2>Yeni Politika</h2>
<form method="post">
    <label>Merchant</label>
    <select name="merchantId">
        <option value="">— merchant seç —</option>
        @foreach (var m in Model.Merchants)
        {
            <option value="@m.MerchantId">@m.Name (@m.Status)</option>
        }
    </select>

    <label>Oran (ondalık; 0.02 = %2, tavan 0.20)</label>
    <input type="number" name="ratePercent" step="0.001" min="0" max="0.20" value="0.02" />

    <label>Sabit ücret (TL, tavan 100)</label>
    <input type="number" name="fixedFee" step="0.01" min="0" max="100" value="0" />

    <div>
        <button class="btn" asp-page-handler="Create">Oluştur</button>
    </div>
</form>

<h2>Politikalar</h2>
@if (Model.Policies.Count == 0)
{
    <p class="muted">Kayıtlı komisyon politikası yok.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Merchant</th><th>Oran</th><th>Sabit Ücret</th><th>Durum</th><th>Oluşturma</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Policies)
            {
                <tr>
                    <td><a asp-page="/Merchants/Details" asp-route-id="@p.MerchantId">@Model.MerchantName(p.MerchantId)</a></td>
                    <td>@p.RatePercent.ToString("0.###") (%@((p.RatePercent * 100).ToString("0.#")))</td>
                    <td>@p.FixedFee.ToString("0.##") TL</td>
                    <td>@p.Status</td>
                    <td>@p.CreatedTime.ToString("g")</td>
                    <td>
                        <form method="post" style="display:inline">
                            <input type="hidden" name="merchantId" value="@p.MerchantId" />
                            <input type="number" name="ratePercent" step="0.001" min="0" max="0.20" value="@p.RatePercent" style="width:5em" />
                            <input type="number" name="fixedFee" step="0.01" min="0" max="100" value="@p.FixedFee" style="width:5em" />
                            <button class="btn" asp-page-handler="UpdateMargin">Güncelle</button>
                        </form>
                        <form method="post" style="display:inline">
                            <input type="hidden" name="merchantId" value="@p.MerchantId" />
                            <input type="hidden" name="status" value="@(p.Status == "Active" ? "Passive" : "Active")" />
                            <button class="btn" asp-page-handler="ChangeStatus" style="background:#6e7781;">
                                @(p.Status == "Active" ? "Pasifleştir" : "Aktifleştir")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}