@page
@model Admin.Pages.Banks.IndexModel
@{
    ViewData["Title"] = "Bankalar";
}

<partial name="_Messages" />

<div class="actions">
    <a class="btn" asp-page="Create">Yeni Banka</a>
</div>

<form method="get">
    <label asp-for="IncludeInactive">
        <input asp-for="IncludeInactive" type="checkbox" style="min-width:auto;" /> Pasifleri de göster
    </label>
    <button type="submit" class="inline">Uygula</button>
</form>

@if (Model.Items.Count == 0)
{
    <p class="muted">Banka yok. "Yeni Banka" ile ekleyin.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Kod</th><th>Ad</th><th>Taksitler</th><th>Aktif</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var b in Model.Items)
            {
                <tr>
                    <td class="key">@b.Code</td>
                    <td>@b.Name</td>
                    <td>@string.Join(", ", b.SupportedInstallments)</td>
                    <td>@(b.IsActive ? "Evet" : "Hayır")</td>
                    <td>
                        <a asp-page="Edit" asp-route-code="@b.Code">Düzenle</a>
                        &middot;
                        <a asp-page="Delete" asp-route-code="@b.Code">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}