@page "{code}"
@model Admin.Pages.Banks.EditModel
@{
    ViewData["Title"] = $"Banka Düzenle — {Model.Code}";
}

<partial name="_Messages" />

<form method="post">
    <label>Banka kodu (değişmez)</label>
    <input value="@Model.Code" class="key" disabled />

    <label>Banka adı (katalogdan, değişmez)</label>
    <input value="@Model.BankName" disabled />

    <label>Desteklenen taksitler</label>
    <div class="installment-grid">
        @for (var n = 1; n <= 15; n++)
        {
            <label class="installment-cell">
                <input type="checkbox" name="Input.Installments" value="@n"
                       checked="@(Model.Input.Installments.Contains(n))" />
                @n
            </label>
        }
    </div>

    <label asp-for="Input.IsActive">
        <input asp-for="Input.IsActive" type="checkbox" style="min-width:auto;" /> Aktif
    </label>

    <div>
        <button type="submit">Kaydet</button>
        <a class="btn" asp-page="Index" style="background:#6e7781;">İptal</a>
    </div>
</form>