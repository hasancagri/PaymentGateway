@page
@model Admin.Pages.Banks.CreateModel
@{
    ViewData["Title"] = "Yeni Banka";
}

<partial name="_Messages" />

@if (Model.Catalog.Count == 0)
{
    <p class="muted">Katalogdaki tüm bankalar eklenmiş; eklenecek banka kalmadı.</p>
    <a class="btn" asp-page="Index">Listeye dön</a>
}
else
{
    <form method="post">
        <label asp-for="Input.Code">Banka (katalogdan seç)</label>
        <select asp-for="Input.Code">
            <option value="">— banka seç —</option>
            @foreach (var b in Model.Catalog)
            {
                <option value="@b.Code">@b.Code — @b.Name</option>
            }
        </select>

        <label>Desteklenen taksitler</label>
        <div class="installment-grid">
            @for (var n = 1; n <= 15; n++)
            {
                <label class="installment-cell">
                    <input type="checkbox" name="Input.Installments" value="@n"
                           checked="@(Model.Input.Installments.Contains(n))" />
                    @n
                </label>
            }
        </div>

        <div>
            <button type="submit">Ekle</button>
            <a class="btn" asp-page="Index" style="background:#6e7781;">İptal</a>
        </div>
    </form>
}