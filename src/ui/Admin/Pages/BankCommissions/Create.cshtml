@page
@model Admin.Pages.BankCommissions.CreateModel
@{
    ViewData["Title"] = "Yeni Banka Komisyonu";
}

<partial name="_Messages" />

<form method="post">
    <label asp-for="Input.BankCode">Banka kodu (4 hane)</label>
    <input asp-for="Input.BankCode" placeholder="0062" />

    <label asp-for="Input.CardBrand">Kart markası</label>
    <select asp-for="Input.CardBrand">
        <option>VISA</option>
        <option>MASTERCARD</option>
        <option>TROY</option>
        <option>AMEX</option>
    </select>

    <label asp-for="Input.CardType">Kart tipi</label>
    <select asp-for="Input.CardType">
        <option>CREDIT</option>
        <option>DEBIT</option>
        <option>PREPAID</option>
    </select>

    <label asp-for="Input.TransactionRegion">İşlem bölgesi</label>
    <select asp-for="Input.TransactionRegion">
        <option>DOMESTIC</option>
        <option>INTERNATIONAL</option>
    </select>

    <label asp-for="Input.InstallmentCount">Taksit sayısı (1 = peşin)</label>
    <input asp-for="Input.InstallmentCount" type="number" min="1" />

    <label asp-for="Input.Rate">Oran (%)</label>
    <input asp-for="Input.Rate" class="rate" type="number" step="0.01" min="0" />

    <div>
        <button type="submit">Ekle</button>
        <a class="btn" asp-page="Index" style="background:#6e7781;">İptal</a>
    </div>
</form>