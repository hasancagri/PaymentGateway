@page
@using System.Globalization
@model Admin.Pages.MerchantCommissions.IndexModel
@{
    ViewData["Title"] = "Merchant Komisyonları";
    string Inv(decimal d) => d.ToString(CultureInfo.InvariantCulture);
}

<partial name="_Messages" />

<div class="actions">
    <a class="btn" asp-page="Create">Merchant Komisyon Grid</a>
</div>

<form method="get">
    <label asp-for="MerchantId">Merchant</label>
    <select asp-for="MerchantId" onchange="this.form.submit()">
        <option value="">— seç —</option>
        @foreach (var m in Model.Merchants)
        {
            <option value="@m.Id">@m.Name (@m.Mcc)</option>
        }
    </select>
    <noscript><button type="submit" class="inline">Göster</button></noscript>
</form>

@if (Model.MerchantId is null || Model.MerchantId == Guid.Empty)
{
    <p class="muted">Komisyonları görmek için bir merchant seç.</p>
}
else if (Model.Rows.Count == 0)
{
    <p class="muted">Bu merchant için girilmiş oran yok. <a asp-page="Create" asp-route-merchantId="@Model.MerchantId">Grid'de ekle</a>.</p>
}
else
{
    <p class="muted">Salt-görünüm. Kırmızı satır: merchant oranı banka tavanının (max) altında/eşit (bilgi amaçlı). Düzenleme için grid'i kullan.</p>
    <table>
        <thead>
            <tr><th>Marka</th><th>Tip</th><th>Bölge</th><th>Taksit</th><th>Banka Aralığı</th><th>Merchant Oranı (%)</th></tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr class="@(row.BelowBankCeiling ? "below-ceiling" : "")">
                    <td>@row.Criteria.CardBrand</td>
                    <td>@row.Criteria.CardType</td>
                    <td>@row.Criteria.TransactionRegion</td>
                    <td>@row.Criteria.InstallmentCount</td>
                    <td>
                        @if (row.BankMax.HasValue)
                        {
                            <span>@Inv(row.BankMin!.Value) – @Inv(row.BankMax.Value)</span>
                        }
                        else
                        {
                            <span class="muted">banka yok</span>
                        }
                    </td>
                    <td>@(row.Rate.HasValue ? Inv(row.Rate.Value) : "")</td>
                </tr>
            }
        </tbody>
    </table>
}