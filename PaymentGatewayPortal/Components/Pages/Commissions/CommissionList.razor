@page "/merchants/{MerchantId:guid}/commissions"
@rendermode InteractiveServer
@attribute [Authorize]
@inject PaymentGatewayPortal.Clients.CommissionBffClient CommissionClient
@inject NavigationManager Navigation

<h2>Merchant Komisyonları</h2>
<a href="/merchants/@MerchantId/commissions/create">Yeni Komisyon</a>
<a href="/merchants/@MerchantId"> ← Geri</a>

@if (_commissions is null)
{
    <p>Yükleniyor...</p>
}
else if (_commissions.Count == 0)
{
    <p>Komisyon kaydı bulunamadı.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Oran (%)</th>
                <th>Kart Markası</th>
                <th>Kart Tipi</th>
                <th>Bölge</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _commissions)
            {
                <tr>
                    <td>@c.Rate</td>
                    <td>@c.CardBrand</td>
                    <td>@c.CardType</td>
                    <td>@c.TransactionRegion</td>
                    <td>
                        <button @onclick="() => UpdateRate(c.Id)">Oran Güncelle</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(_message))
{
    <p style="color:green">@_message</p>
}

@code {
    [Parameter] public Guid MerchantId { get; set; }

    private List<PaymentGatewayPortal.Models.MerchantCommissionListItem>? _commissions;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var result = await CommissionClient.GetMerchantCommissionsAsync(MerchantId);
        _commissions = result?.Data ?? [];
    }

    private async Task UpdateRate(Guid commissionId)
    {
        var newRateStr = await Task.FromResult("0");
        if (!decimal.TryParse(newRateStr, out var newRate)) return;

        var response = await CommissionClient.UpdateCommissionRateAsync(commissionId, newRate);
        if (response.IsSuccessStatusCode)
        {
            _message = "Oran güncellendi.";
            var result = await CommissionClient.GetMerchantCommissionsAsync(MerchantId);
            _commissions = result?.Data ?? [];
        }
    }
}