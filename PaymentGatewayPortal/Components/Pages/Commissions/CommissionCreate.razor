@page "/merchants/{MerchantId:guid}/commissions/create"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject PaymentGatewayPortal.Clients.CommissionBffClient CommissionClient
@inject NavigationManager Navigation

<h2>Yeni Komisyon Tanımla</h2>

@if (!string.IsNullOrEmpty(_error))
{
    <p style="color:red">@_error</p>
}

<EditForm Model="_model" OnValidSubmit="HandleCreate">
    <DataAnnotationsValidator />
    <div><label>Banka Komisyon ID</label><InputText @bind-Value="_model.BankCommissionIdText" /></div>
    <div><label>Kart Markası (1=Visa,2=MC,3=Amex,4=Troy)</label><InputNumber @bind-Value="_model.CardBrand" /></div>
    <div><label>Kart Tipi (1=Consumer,2=Commercial)</label><InputNumber @bind-Value="_model.CardType" /></div>
    <div><label>Bölge (1=Domestic,2=International)</label><InputNumber @bind-Value="_model.TransactionRegion" /></div>
    <div><label>Merchant Oranı (%)</label><InputNumber @bind-Value="_model.MerchantRate" /></div>
    <button type="submit" disabled="@_loading">
        @(_loading ? "Kaydediliyor..." : "Kaydet")
    </button>
    <a href="/merchants/@MerchantId/commissions">İptal</a>
</EditForm>

@code {
    [Parameter] public Guid MerchantId { get; set; }

    private readonly FormModel _model = new();
    private bool _loading;
    private string? _error;

    private async Task HandleCreate()
    {
        if (!Guid.TryParse(_model.BankCommissionIdText, out var bankCommissionId))
        {
            _error = "Geçersiz Banka Komisyon ID.";
            return;
        }

        _loading = true;
        _error = null;

        var request = new PaymentGatewayPortal.Models.DefineMerchantCommissionRequest(
            MerchantId, bankCommissionId,
            _model.CardBrand, _model.CardType, _model.TransactionRegion,
            _model.MerchantRate);

        var response = await CommissionClient.DefineMerchantCommissionAsync(request);
        if (response.IsSuccessStatusCode)
            Navigation.NavigateTo($"/merchants/{MerchantId}/commissions");
        else
            _error = "Komisyon tanımlanamadı.";

        _loading = false;
    }

    private class FormModel
    {
        public string BankCommissionIdText { get; set; } = string.Empty;
        public int CardBrand { get; set; } = 1;
        public int CardType { get; set; } = 1;
        public int TransactionRegion { get; set; } = 1;
        public decimal MerchantRate { get; set; }
    }
}