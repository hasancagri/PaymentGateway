@page "/merchants/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject PaymentGatewayPortal.Clients.MerchantBffClient MerchantClient
@inject NavigationManager Navigation

@if (_merchant is null)
{
    <p>Yükleniyor...</p>
}
else
{
    <h2>@_merchant.Name</h2>

    @if (!string.IsNullOrEmpty(_message))
    {
        <p style="color:green">@_message</p>
    }

    <dl>
        <dt>Durum</dt><dd>@_merchant.Status</dd>
        <dt>E-posta</dt><dd>@_merchant.Email</dd>
        <dt>Telefon</dt><dd>@_merchant.Phone</dd>
        <dt>Ülke</dt><dd>@_merchant.Country</dd>
        <dt>Şehir</dt><dd>@_merchant.City</dd>
        <dt>MCC</dt><dd>@_merchant.Mcc</dd>
    </dl>

    <div>
        <button @onclick='() => SetStatus("activate")'>Aktif Et</button>
        <button @onclick='() => SetStatus("deactivate")'>Pasif Et</button>
        <button @onclick='() => SetStatus("suspend")'>Askıya Al</button>
    </div>

    <hr />
    <a href="/merchants/@Id/commissions">Komisyonlar</a>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private PaymentGatewayPortal.Models.MerchantDetail? _merchant;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var result = await MerchantClient.GetByIdAsync(Id);
        _merchant = result?.Data;
    }

    private async Task SetStatus(string action)
    {
        var reason = "Portal üzerinden güncellendi";
        HttpResponseMessage? response = action switch
        {
            "activate" => await MerchantClient.ActivateAsync(Id, reason),
            "deactivate" => await MerchantClient.DeactivateAsync(Id, reason),
            "suspend" => await MerchantClient.SuspendAsync(Id, reason),
            _ => null
        };

        if (response?.IsSuccessStatusCode == true)
        {
            _message = "İşlem başarılı.";
            var result = await MerchantClient.GetByIdAsync(Id);
            _merchant = result?.Data;
        }
    }
}