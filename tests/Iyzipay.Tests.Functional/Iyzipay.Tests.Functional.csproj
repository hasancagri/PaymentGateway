<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Canlı iyzico sandbox testleri: API anahtarı ister. Varsayılan "dotnet test" koşusuna
         GİRMEZ (IsTestProject=false) ama her derlemede derlenir. Elle koşu:
         dotnet test tests/Iyzipay.Tests.Functional -p:IsTestProject=true -->
    <IsTestProject>false</IsTestProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\services\Iyzipay\Iyzipay.csproj" />
  </ItemGroup>

</Project>